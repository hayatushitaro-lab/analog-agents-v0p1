{
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "0.1",
            "0.2"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "reference_assisted": {
          "type": "boolean"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "netlist",
                  "static_ir",
                  "model_metadata",
                  "template",
                  "run_log",
                  "data",
                  "calculation",
                  "review",
                  "reference",
                  "model_source"
                ]
              },
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "input_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "path",
              "sha256",
              "role",
              "origin"
            ],
            "additionalProperties": false
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "valid",
                  "failed",
                  "partial",
                  "excluded"
                ]
              },
              "artifact_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "mode_ref": {
                "type": "string",
                "minLength": 1
              },
              "conditions": {
                "type": "string",
                "minLength": 1
              },
              "fixture_review_ref": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "status",
              "artifact_refs",
              "mode_ref",
              "conditions",
              "fixture_review_ref",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "reference_assisted",
        "artifacts",
        "runs"
      ],
      "additionalProperties": false
    },
    "report_requirements": {
      "type": "object",
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "request": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "section",
              "request",
              "required"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "requirements"
      ],
      "additionalProperties": false
    },
    "design_evidence": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "DIRECT",
                  "DERIVED",
                  "SIMULATED",
                  "INFERRED",
                  "UNKNOWN"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "uncertainty": {
                "type": "string"
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string"
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "verification": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "run_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "critical_review_required": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "statement",
              "source_refs",
              "locator",
              "confidence",
              "uncertainty",
              "impact",
              "method",
              "alternatives",
              "verification",
              "run_refs"
            ],
            "additionalProperties": false
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "type": "string",
                "enum": [
                  "input",
                  "output",
                  "inout",
                  "supply",
                  "ground",
                  "unknown"
                ]
              },
              "claim_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "name",
              "direction",
              "claim_refs"
            ],
            "additionalProperties": false
          }
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "drivers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "port": {
                      "type": "string",
                      "minLength": 1
                    },
                    "behavior": {
                      "type": "string",
                      "enum": [
                        "drive",
                        "observe",
                        "load"
                      ]
                    },
                    "setting": {
                      "type": "string",
                      "minLength": 1
                    },
                    "claim_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    "external_drive_justification": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "port",
                    "behavior",
                    "setting",
                    "claim_refs",
                    "external_drive_justification"
                  ],
                  "additionalProperties": false
                }
              },
              "claim_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "description",
              "drivers",
              "claim_refs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "claims",
        "ports",
        "modes"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "SIMULATED",
                  "DERIVED"
                ]
              },
              "mode_ref": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "expected_cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "conditions": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "conditions"
                  ],
                  "additionalProperties": false
                }
              },
              "typical_case_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "samples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "case_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "number"
                    },
                    "source_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    },
                    "run_ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "case_id",
                    "value",
                    "source_ref",
                    "locator",
                    "run_ref"
                  ],
                  "additionalProperties": false
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "unmeasured",
                  "not_applicable"
                ]
              },
              "reason": {
                "type": "string"
              },
              "impact": {
                "type": "string"
              },
              "next_action": {
                "type": "string"
              },
              "claim_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "name",
              "unit",
              "kind",
              "mode_ref",
              "definition",
              "method",
              "scope",
              "expected_cases",
              "typical_case_id",
              "samples",
              "status",
              "reason",
              "impact",
              "next_action",
              "claim_refs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "metrics"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement_ref": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "unmeasured",
                  "not_applicable"
                ]
              },
              "claim_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "metric_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string"
              },
              "impact": {
                "type": "string"
              },
              "next_action": {
                "type": "string"
              }
            },
            "required": [
              "requirement_ref",
              "status",
              "claim_refs",
              "metric_refs",
              "reason",
              "impact",
              "next_action"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "author_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "subject_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "result": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "artifact_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "subject_refs",
              "result",
              "artifact_refs"
            ],
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "blocking",
                  "nonblocking"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "resolved"
                ]
              },
              "affected_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "resolution": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "severity",
              "status",
              "affected_refs",
              "description",
              "resolution"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "author_id",
        "reviewer_id",
        "independent",
        "checks",
        "findings"
      ],
      "additionalProperties": false
    },
    "report_map": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "claim_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "metric_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "stance": {
                "type": "string",
                "enum": [
                  "asserted",
                  "qualified",
                  "unknown"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "section",
              "claim_refs",
              "metric_refs",
              "stance",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "blocks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "manifest",
    "report_requirements",
    "design_evidence",
    "metrics",
    "coverage",
    "review"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixed-circuit report evidence handoff 0.1"
}
